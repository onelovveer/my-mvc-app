@page
@model WebApplication1.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="mb-3 text-center">
            <div class="wc-kicker"><i class="bi bi-shield-lock wc-icon me-1"></i> Авторизация</div>
            <h2 class="mt-2 mb-0">Вход</h2>
            <div class="wc-help">Войдите в аккаунт или зарегистрируйтесь.</div>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Input.Role" />

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label">Логин</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Input.Username" class="form-control" placeholder="Введите логин" />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                        <div class="wc-help small mt-1">Введите логин, указанный при регистрации.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Введите пароль" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <div class="wc-help small mt-1">Введите пароль для входа.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                        </button>
                        <div class="d-flex justify-content-between">
                            <a asp-page="/Account/Register" asp-route-role="@Model.Input.Role" class="btn btn-outline-primary">
                                <i class="bi bi-person-plus me-1"></i> Регистрация
                            </a>
                            <a asp-page="/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> На главную
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

