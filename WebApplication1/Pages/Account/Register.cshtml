@page
@model WebApplication1.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="mb-3 text-center">
            <div class="wc-kicker"><i class="bi bi-person-plus wc-icon me-1"></i> Создание аккаунта</div>
            <h2 class="mt-2 mb-0">Регистрация</h2>
            <div class="wc-help">Создайте учётную запись и начните пользоваться сервисом.</div>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Input.Role" />

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label">Логин</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Input.Username" class="form-control" placeholder="Придумайте логин" />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                        <div class="wc-help small mt-1">Логин должен быть уникальным.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Пароль</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Придумайте пароль" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <div class="wc-help small mt-1">Минимум 4 символа.</div>
                    </div>

                    <div id="clientFields" class="mb-3">
                        <hr class="wc-divider" />
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-card-text wc-icon me-2"></i>
                            <div>
                                <div class="fw-semibold">Данные клиента</div>
                                <div class="wc-help small">Будут отображаться в истории абонементов.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">ФИО</label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="Иванов Иван" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i> Зарегистрироваться
                        </button>
                        <div class="d-flex justify-content-between">
                            <a asp-page="/Account/Login" asp-route-role="@Model.Input.Role" class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-in-right me-1"></i> У меня уже есть аккаунт
                            </a>
                            <a asp-page="/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> На главную
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

